# Blacklight deck: torus.mhd_w_bcc.00999 (AthenaK binary layout), slow light, 345 GHz
model_type  = simulation
num_threads = 8
output_format = npz
output_file   = $TMP/kpolaris/bl_runs/slow_345_{d}.npz
output_camera = false
checkpoint_geodesic_save = false
checkpoint_geodesic_load = false
checkpoint_sample_save   = false
checkpoint_sample_load   = false
simulation_format       = athenak
simulation_file         = $TMP/kpolaris/bin/torus_{05d}.bin
simulation_multiple     = true
simulation_start        = 990
simulation_end          = 999
simulation_coord        = cks
simulation_a            = 0.9
simulation_m_msun       = 6.2e9
simulation_rho_cgs      = 1.0e-21
simulation_interp       = true
simulation_block_interp = false
camera_type       = plane
camera_r          = 100.0
camera_th         = 60.0
camera_ph         = 0.0
camera_urn        = 0.0
camera_uthn       = 0.0
camera_uphn       = 0.0
camera_k_r        = 1.0
camera_k_th       = 0.0
camera_k_ph       = 0.0
camera_rotation   = 0.0
camera_width      = 30.0
camera_resolution = 256
ray_flat        = false
ray_terminate   = additive
ray_factor      = 0.001
ray_integrator  = rk4
ray_step        = 0.0125
ray_max_steps   = 2500
ray_max_retries = 20
ray_tol_abs     = 1.0e-8
ray_tol_rel     = 1.0e-8
image_light           = true
image_num_frequencies = 1
image_frequency       = 3.45e11
image_normalization   = infinity
image_polarization    = true
image_rotation_split  = false
image_time            = false
image_length          = false
image_lambda          = false
image_emission        = false
image_tau             = false
image_lambda_ave      = false
image_emission_ave    = false
image_tau_int         = false
image_crossings       = false
render_num_images = 0
slow_light_on   = true
slow_interp     = true
slow_chunk_size = 10
slow_t_start    = 78570.0
slow_dt         = 1.0
slow_num_images = 1
slow_offset     = 0
adaptive_max_level = 0
plasma_mu         = 0.5
plasma_ne_ni      = 1.0
plasma_model      = ti_te_beta
plasma_use_p      = true
plasma_gamma      = 1.4444444444444444
plasma_gamma_i    = 1.6666666666666667
plasma_gamma_e    = 1.3333333333333333
plasma_rat_low    = 1.0
plasma_rat_high   = 10.0
plasma_power_frac = 0.0
plasma_kappa_frac = 0.0
cut_rho_min          = -1.0
cut_rho_max          = -1.0
cut_n_e_min          = -1.0
cut_n_e_max          = -1.0
cut_p_gas_min        = -1.0
cut_p_gas_max        = -1.0
cut_theta_e_min      = -1.0
cut_theta_e_max      = -1.0
cut_b_min            = -1.0
cut_b_max            = -1.0
cut_sigma_min        = -1.0
cut_sigma_max        = 1.0
cut_beta_inverse_min = -1.0
cut_beta_inverse_max = -1.0
cut_omit_near        = false
cut_omit_far         = false
cut_omit_in          = -1.0
cut_omit_out         = -1.0
cut_midplane_theta   = 0.0
cut_midplane_z       = 0.0
cut_plane            = false
fallback_nan = true
