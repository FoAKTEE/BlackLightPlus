+/*
+ * pixel_rt.c -- single-pixel RAPTOR image values for arbitrary image-plane
+ * coordinates (dag.md R02), as a library for ccall.
+ *
+ *   void raptor_rt_setup(const char *model_in)
+ * reads model.in (read_model), bbh.in ($RAPTOR_BBH) and the scene
+ * ($RAPTOR_SCENE), and sets the constants, as main() does.
+ *
+ *   int raptor_rt_pixel(double alpha, double beta, double iquv[4])
+ * traces the pixel (integrate_geodesic: camera, march) and runs the transfer
+ * at FREQ_MIN: radiative_transfer_polarized when POL, else
+ * radiative_transfer_unpolarized; iquv is the observed (I, Q, U, V) in cgs
+ * (invariant times nu^3), the values main() stores before the 1e23 Jansky
+ * factor. Returns the number of stored states.
+ */
+#include "definitions.h"
+#include "functions.h"
+#include "global_vars.h"
+#include "model_definitions.h"
+#include "model_functions.h"
+#include "model_global_vars.h"
+
+void raptor_rt_setup(const char *model_in) {
+    char *argv[4] = {"raptor", (char *)model_in, "none", "0"};
+    read_model(argv);
+    init_model();
+    set_constants();
+}
+
+int raptor_rt_pixel(double alpha, double beta, double iquv[4]) {
+    int steps = 0;
+    double *lp = malloc(9 * max_steps * sizeof(double));
+    integrate_geodesic(alpha, beta, lp, &steps, CUTOFF_INNER);
+    for (int s = 0; s < 4; s++)
+        iquv[s] = 0.;
+#if (POL)
+    double f_x = 0., f_y = 0., pp = 0., tau = 0., tauF = 0.;
+    radiative_transfer_polarized(lp, steps, FREQ_MIN, &f_x, &f_y, &pp, 0, iquv,
+                                 &tau, &tauF);
+#else
+    double IQUV[num_frequencies][4] = {{0.}}, tau[num_frequencies] = {0.};
+    double freqs[num_frequencies] = {FREQ_MIN};
+    radiative_transfer_unpolarized(lp, steps, freqs, IQUV, tau);
+    iquv[0] = IQUV[0][0] * pow(FREQ_MIN, 3.);
+#endif
+    free(lp);
+    return steps;
+}
