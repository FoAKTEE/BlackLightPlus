diff --git a/tests/ray_dump.c b/tests/ray_dump.c
new file mode 100644
index 0000000..7fbc5db
--- /dev/null
+++ b/tests/ray_dump.c
@@ -0,0 +1,72 @@
+/*
+ * ray_dump.c -- geodesic ray-dump interface (dag.md R04).
+ *
+ * Library entry (built into tests/libraptor_*.so for ccall from the
+ * BlackLightPlus comparison scripts) and a command-line driver.
+ *
+ *   int raptor_trace_state(const double state_in[8], double *lightpath,
+ *                          int *steps, int *end_class)
+ * state_in = (x^mu, k_mu): position and the covariant received wave vector
+ * (future-directed, k_t = -1 at the camera). k^mu = g^{mu nu} k_nu is traced
+ * backward (d lambda < 0) by integrate_geodesic_state (M3). On return
+ * lightpath[9 n + 0..7] = (x^mu, k^mu) of state n = 0..steps-1 and
+ * lightpath[9 n + 8] = |h|, the affine step taken from state n; the terminal
+ * state is lightpath[9 steps + 0..7]. end_class: 1/2 captured by hole 1/2,
+ * 3 escaped, 4 step budget, 5 non-finite. lightpath must hold
+ * 9 (nmax + 1) doubles. Returns steps.
+ *
+ *   void raptor_camera_state(double alpha, double beta, double state_out[8])
+ * The initial (x^mu, k^mu) of initialize_photon for image coordinates
+ * (alpha, beta) (M4 plane-parallel camera when CAMERA_PP).
+ *
+ * CLI: ray_dump < states.txt > dump.bin, one state "x0 x1 x2 x3 k0 k1 k2 k3"
+ * per line; per ray writes int32 steps, int32 end_class, then
+ * (steps + 1) x 9 float64 lightpath entries.
+ */
+#include "definitions.h"
+#include "functions.h"
+#include "global_vars.h"
+#include "model_definitions.h"
+#include "model_functions.h"
+#include "model_global_vars.h"
+
+void raptor_load_bbh(const char *path) { read_bbh_config(path); }
+
+int raptor_trace_state(const double state_in[8], double *lightpath, int *steps,
+                       int *end_class) {
+    double photon_u[8], X[4], kd[4], ku[4];
+    for (int i = 0; i < 4; i++) {
+        X[i] = state_in[i];
+        kd[i] = state_in[4 + i];
+    }
+    raise_index(X, kd, ku);
+    for (int i = 0; i < 4; i++) {
+        photon_u[i] = X[i];
+        photon_u[4 + i] = ku[i];
+    }
+    integrate_geodesic_state(photon_u, lightpath, steps);
+    *end_class = (int)(-lightpath[9 * (*steps) + 8]);
+    return *steps;
+}
+
+void raptor_camera_state(double alpha, double beta, double state_out[8]) {
+    initialize_photon(alpha, beta, state_out, 0.);
+}
+
+#ifndef RAY_DUMP_LIBRARY
+int main(void) {
+    read_bbh_config(getenv("RAPTOR_BBH") ? getenv("RAPTOR_BBH") : "bbh.in");
+    double *lp = malloc(9 * (bbh.nmax + 1) * sizeof(double));
+    double s[8];
+    while (scanf("%lf %lf %lf %lf %lf %lf %lf %lf", &s[0], &s[1], &s[2], &s[3],
+                 &s[4], &s[5], &s[6], &s[7]) == 8) {
+        int steps, cls;
+        raptor_trace_state(s, lp, &steps, &cls);
+        int hdr[2] = {steps, cls};
+        fwrite(hdr, sizeof(int), 2, stdout);
+        fwrite(lp, sizeof(double), 9 * (steps + 1), stdout);
+    }
+    free(lp);
+    return 0;
+}
+#endif
