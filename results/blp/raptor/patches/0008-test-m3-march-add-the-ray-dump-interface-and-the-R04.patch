 # every core source except main.c, plus the analytic model
 CORE=""
 for f in core io GRmath gr_integrator rte_integrator pol_rte_integrator metric \
@@ -20,10 +26,26 @@ for f in core io GRmath gr_integrator rte_integrator pol_rte_integrator metric \
 done
 CORE="$CORE $HERE/model/blp_analytic/model.c"
 
-$CC $CFLAGS $INC "$HERE/tests/coeff_table.c" "$HERE/src/blp_coeffs.c" \
+# upstream single-hole CKS headers: the blp_analytic headers with metric (CKS)
+CKSDEF="$OUT/cks_defs"
