@@ -765,6 +765,35 @@ void radiative_transfer_polarized(double *lightpath, int steps,
     }
     modvar.igrid_c = -1;
 
+#if (STEP_BBH)
+    // BlackLightPlus sample set (reverse_march.jl StoredPath): every stored
