+    for (path_counter = steps - 1; path_counter >= 0; path_counter--) {
+        LOOP_i {
+            X_u[i] = lightpath[path_counter * 9 + i];
+            k_u[i] = lightpath[path_counter * 9 + 4 + i];
+        }
+        double dl_emit = fabs(lightpath[path_counter * 9 + 8]);
+        double k_emit[4];
+        LOOP_i k_emit[i] = k_u[i];
+        if (get_fluid_params(X_u, &modvar) && get_r(X_u) < RT_OUTER_CUTOFF) {
+            pol_integration_step(modvar, frequency, &dl_emit, C_CONST, X_u,
+                                 k_emit, k_d, &POLARIZATION_ACTIVE, f_u,
+                                 f_tetrad_u, tetrad_d, tetrad_u, S_A, &Iinv,
+                                 &Iinv_pol, tau, tauF);
+        }
+        if (POLARIZATION_ACTIVE && path_counter > 0) {
+            LOOP_i {
+                photon_u_current[i] = X_u[i];
+                photon_u_current[i + 4] = k_u[i];
+            }
+            rk4_step_f(photon_u_current, f_u,
+                       fabs(lightpath[(path_counter - 1) * 9 + 8]));
+        }
+    }
+#else
     // Move backward along constructed lightpath
     for (path_counter = steps - 1; path_counter > 0; path_counter--) {
         // Current position, wave vector, and dlambda
@@ -810,6 +839,7 @@ void radiative_transfer_polarized(double *lightpath, int steps,
             rk4_step_f(photon_u_current, f_u, dl_current);
         }
     } // End of for(path_counter...
+#endif
 
