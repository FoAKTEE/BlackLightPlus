index b62ed37..471721d 100755
--- a/src/gr_integrator.c
+++ b/src/gr_integrator.c
@@ -332,9 +332,88 @@ void f_geodesic(double *y, double *fvector) {
     }
 }
 
+#if (STEP_BBH)
+// BlackLightPlus fixed-control march (spacetimes.jl superposed_control,
+// integrator.jl march_stop): step h = horizon_distance / C; captured when
+// horizon_distance < horizon_eps, non-finite, or the normal-frame energy
+// exceeds capture_redshift; escaped when R > escape and R increases.
+static int bbh_captured(const double X_u[4], const double k_u[4], double *dmin) {
+    double g_uu[4][4];
+    *dmin = horizon_distance(X_u);
+    metric_uu((double *)X_u, g_uu);
+    double En = fabs(k_u[0]) / sqrt(-g_uu[0][0]);
+    return *dmin < bbh.horizon_eps || !isfinite(*dmin) ||
+           !(En <= bbh.capture_redshift);
+}
+
+// End class of a terminal state (BlackLightPlus figure-driver end_class):
+// 1/2 captured by hole 1/2 (nearest horizon), 3 escaped, 4 step budget,
+// 5 non-finite.
+static int bbh_end_class(const double y[8]) {
+    for (int i = 0; i < 8; i++)
+        if (!isfinite(y[i]))
+            return 5;
+    double dmin;
+    if (bbh_captured(y, y + 4, &dmin)) {
+        int best = 0;
+        double dbest = INFINITY;
+        for (int A = 0; A < bbh.n; A++) {
+            double dA = ks_radius_hole(y, A) - horizon_radius_hole(A);
+            if (dA < dbest) {
+                dbest = dA;
+                best = A;
+            }
+        }
+        return best + 1;
+    }
+    if (sqrt(y[1] * y[1] + y[2] * y[2] + y[3] * y[3]) > bbh.escape)
+        return 3;
+    return 4;
+}
+
+// Trace photon_u = (x^mu, k^mu) (received wave vector, integrated with
+// d lambda = -h < 0). lightpath[9 n + 0..7] = state n and lightpath[9 n + 8]
+// = h taken from it, n = 0..steps-1; the terminal state is stored at
+// lightpath[9 steps + 0..7] and minus its end class at lightpath[9 steps + 8].
+void integrate_geodesic_state(double photon_u[8], double *lightpath,
+                              int *steps) {
+    double r_prev = INFINITY;
+    int n = 0;
+    for (int it = 0; it < bbh.nmax; it++) {
+        double dmin;
+        int cap = bbh_captured(photon_u, photon_u + 4, &dmin);
+        double R = sqrt(photon_u[1] * photon_u[1] + photon_u[2] * photon_u[2] +
+                        photon_u[3] * photon_u[3]);
+        if (cap || (R > bbh.escape && R > r_prev))
+            break;
+        r_prev = R;
+        double h = dmin / bbh.C;
+        for (int q = 0; q < 8; q++)
+            lightpath[n * 9 + q] = photon_u[q];
+        lightpath[n * 9 + 8] = h;
+#if (int_method == RK4)
+        rk4_step(photon_u, &f_geodesic, -h);
+#else
+#error "STEP_BBH requires int_method RK4"
+#endif
+        n++;
+    }
+    for (int q = 0; q < 8; q++)
+        lightpath[n * 9 + q] = photon_u[q];
+    lightpath[n * 9 + 8] = -(double)bbh_end_class(photon_u);
+    *steps = n;
+}
+#endif
+
 // Integrate the null geodesic defined by "photon_u"
 void integrate_geodesic(double alpha, double beta, double *lightpath,
                         int *steps, double cutoff_inner) {
+#if (STEP_BBH)
+    double photon_bbh[8];
+    initialize_photon(alpha, beta, photon_bbh, 0.);
+    integrate_geodesic_state(photon_bbh, lightpath, steps);
+    return;
+#endif
     int q;
     double t_init = 0.;
     double dlambda_adaptive = -0.1;
