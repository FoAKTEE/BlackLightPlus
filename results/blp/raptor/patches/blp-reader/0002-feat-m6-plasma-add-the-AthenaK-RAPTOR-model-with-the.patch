diff --git a/model/athenak/tests/athenak_probe.c b/model/athenak/tests/athenak_probe.c
new file mode 100644
index 0000000..e489846
--- /dev/null
+++ b/model/athenak/tests/athenak_probe.c
@@ -0,0 +1,214 @@
+/*
+ * athenak_probe.c
+ *
+ * Stand-alone probe of the RAPTOR AthenaK data layer (athenak_mesh.c,
+ * athenak_plasma.c): loads a snapshot, samples it at the points of a points
+ * file and writes the owning block, the interpolated primitives, u^mu, b^mu
+ * and the plasma decode per point. It is the RAPTOR half of the R06 reader
+ * acceptance (results/blp/raptor/tools/r06_*.jl in BlackLightPlus writes the
+ * points and the BlackLightPlus half).
+ *
+ * Build (from this directory):
+ *   h5cc -std=c99 -O2 -fopenmp -I.. athenak_probe.c ../athenak_mesh.c \
+ *        ../athenak_plasma.c -o athenak_probe -lm
+ *
+ * Usage:
+ *   athenak_probe SNAPSHOT --load-only [--threads N] [--gamma G]
+ *   athenak_probe SNAPSHOT POINTS OUT --mbh M_G --ms MS_G [--rhigh R]
+ *                 [--rlow R] [--sigma-cut S] [--gamma G] [--threads N]
+ *
+ * POINTS: int64 n, int64 has_metric, then n records of float64
+ *   x, y, z[, gcov[16], gcon[16]] (row-major, index 0 = t).
+ * OUT: int64 n, int64 ncol, then n records of ncol float64, columns
+ *   block (0-based, -1 outside), rho, u1, u2, u3, eint, b1, b2, b3, pgas,
+ *   ucon[4], ucov[4], bcon[4], bcov[4], b_sq, n_e, B, theta_e, sigma,
+ *   beta_inv, rho_cgs, pgas_cgs, emit, omit, u.u, u.b
+ * (the four-vector and plasma columns need has_metric = 1, else zero).
+ * A JSON summary (load time, peak RSS, locate mode) goes to stdout.
+ * Constants are the BlackLightPlus set (src/constants.jl) with G = 6.6743e-8.
+ */
+
+#define _GNU_SOURCE
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/resource.h>
+#ifdef _OPENMP
+#include <omp.h>
+#endif
+
+#include "athenak_mesh.h"
+#include "athenak_plasma.h"
+
+#define NCOL 38
+
+static double peak_rss_gb(void) {
+    struct rusage ru;
+    getrusage(RUSAGE_SELF, &ru);
+    return ru.ru_maxrss / 1048576.0; /* KiB -> GiB */
+}
+
+int main(int argc, char **argv) {
+    if (argc < 3) {
+        fprintf(stderr, "usage: see athenak_probe.c\n");
+        return 2;
+    }
+    const char *snap = argv[1];
+    int load_only = 0, threads = 0;
+    const char *pts = NULL, *out = NULL;
+    double gamma = 0, mbh = 0, ms = 0;
+    athk_plasma_params par;
+    athk_plasma_defaults(&par);
+    int ai = 2;
+    if (!strcmp(argv[2], "--load-only")) {
+        load_only = 1;
+        ai = 3;
+    } else {
+        if (argc < 4)
+            return 2;
+        pts = argv[2];
+        out = argv[3];
+        ai = 4;
+    }
+    for (; ai < argc; ai++) {
+        const char *a = argv[ai];
+        double v = ai + 1 < argc ? atof(argv[ai + 1]) : 0;
+        if (!strcmp(a, "--threads"))
+            threads = (int)v;
+        else if (!strcmp(a, "--gamma"))
+            gamma = v;
+        else if (!strcmp(a, "--mbh"))
+            mbh = v;
+        else if (!strcmp(a, "--ms"))
+            ms = v;
+        else if (!strcmp(a, "--rhigh"))
+            par.rat_high = v;
+        else if (!strcmp(a, "--rlow"))
+            par.rat_low = v;
+        else if (!strcmp(a, "--sigma-cut"))
+            par.cut_sigma_max = v;
+        else {
+            fprintf(stderr, "unknown option %s\n", a);
+            return 2;
+        }
+        ai++;
+    }
+
+    athk_mesh m;
+    double rss0 = peak_rss_gb();
+    if (athk_load(snap, gamma, threads, &m))
+        return 1;
+    double rss_load = peak_rss_gb();
+    const char *mode[3] = {"table", "hash", "scan"};
+    int lmin = m.level[0], lmax = m.level[0];
+    for (int b = 1; b < m.nmb; b++) {
+        lmin = m.level[b] < lmin ? m.level[b] : lmin;
+        lmax = m.level[b] > lmax ? m.level[b] : lmax;
+    }
+    printf("{\"snapshot\": \"%s\", \"format\": \"%s\", \"nmb\": %d, "
+           "\"block\": [%d, %d, %d], \"levels\": [%d, %d], "
+           "\"locate\": \"%s\", \"gamma\": %.17g, \"gamma_dump\": %.17g, "
+           "\"stored_press\": %d, \"nbad\": %zu, \"time\": %.17g, "
+           "\"load_s\": %.4f, \"data_bytes\": %zu, "
+           "\"peak_rss_gb_before\": %.4f, \"peak_rss_gb_load\": %.4f",
+           snap, m.format, m.nmb, m.ni, m.nj, m.nk, lmin, lmax,
+           mode[m.locate_mode], m.gamma, m.gamma_dump, m.stored_press, m.nbad,
+           m.time, m.load_seconds, m.bytes_data, rss0, rss_load);
+    if (load_only) {
+        printf("}\n");
+        athk_free(&m);
+        return 0;
+    }
+
+    FILE *fp = fopen(pts, "rb");
+    if (!fp) {
+        perror(pts);
+        return 1;
+    }
+    int64_t hdr[2];
+    if (fread(hdr, sizeof(int64_t), 2, fp) != 2)
+        return 1;
+    int64_t n = hdr[0], has_metric = hdr[1];
+    size_t rec = has_metric ? 35 : 3;
+    double *in = malloc((size_t)n * rec * sizeof(double));
+    if (fread(in, sizeof(double), (size_t)n * rec, fp) != (size_t)n * rec) {
+        fprintf(stderr, "short points file\n");
+        return 1;
+    }
+    fclose(fp);
+
+    /* BlackLightPlus constants (src/constants.jl) */
+    const double G = 6.6743e-8, CL = 2.99792458e10, MP = 1.6726e-24,
+                 ME = 9.1094e-28;
+    athk_plasma_units(&par, mbh, ms, G, CL, MP, ME);
+    par.gamma = m.gamma;
+
+    double *res = calloc((size_t)n * NCOL, sizeof(double));
+#ifdef _OPENMP
+    double t0 = omp_get_wtime();
+#endif
+#pragma omp parallel for schedule(dynamic, 256)
+    for (int64_t q = 0; q < n; q++) {
+        const double *r = in + q * rec;
+        double *o = res + q * NCOL;
+        double prim[ATHK_NPRIM];
+        int b = athk_sample(&m, r[0], r[1], r[2], prim);
+        o[0] = b;
+        for (int p = 0; p < ATHK_NPRIM; p++)
+            o[1 + p] = prim[p];
+        double pgas = athk_pgas(prim[ATHK_EINT], m.gamma);
+        o[9] = pgas;
+        if (!has_metric || b < 0)
+            continue;
+        double gcov[4][4], gcon[4][4];
+        for (int i = 0; i < 4; i++)
+            for (int j = 0; j < 4; j++) {
+                gcov[i][j] = r[3 + 4 * i + j];
+                gcon[i][j] = r[19 + 4 * i + j];
+            }
+        athk_fourvec fv;
+        athk_four_vectors(prim, gcov, gcon, &fv);
+        for (int i = 0; i < 4; i++) {
+            o[10 + i] = fv.ucon[i];
+            o[14 + i] = fv.ucov[i];
+            o[18 + i] = fv.bcon[i];
+            o[22 + i] = fv.bcov[i];
+        }
+        o[26] = fv.b_sq;
+        athk_plasma pl;
+        int emit = athk_plasma_decode(&par, prim[ATHK_DENS], pgas, fv.b_sq, &pl);
+        o[27] = pl.n_e_cgs;
+        o[28] = pl.bb_cgs;
+        o[29] = pl.theta_e;
+        o[30] = pl.sigma;
+        o[31] = pl.beta_inv;
+        o[32] = pl.rho_cgs;
+        o[33] = pl.pgas_cgs;
+        o[34] = emit;
+        o[35] = pl.omit;
+        double uu = 0, ub = 0;
+        for (int i = 0; i < 4; i++) {
+            uu += fv.ucon[i] * fv.ucov[i];
+            ub += fv.bcon[i] * fv.ucov[i];
+        }
+        o[36] = uu;
+        o[37] = ub;
+    }
+    double ts = 0;
+#ifdef _OPENMP
+    ts = omp_get_wtime() - t0;
+#endif
+    fp = fopen(out, "wb");
+    int64_t oh[2] = {n, NCOL};
+    fwrite(oh, sizeof(int64_t), 2, fp);
+    fwrite(res, sizeof(double), (size_t)n * NCOL, fp);
+    fclose(fp);
+    printf(", \"npoints\": %lld, \"sample_s\": %.4f, \"peak_rss_gb\": %.4f}\n",
+           (long long)n, ts, peak_rss_gb());
+    free(in);
+    free(res);
+    athk_free(&m);
+    return 0;
+}
