new file mode 100644
index 0000000..1aa349b
--- /dev/null
+++ b/model/athenak/athenak_plasma.c
@@ -0,0 +1,121 @@
+/*
+ * athenak_plasma.c
+ *
+ * Primitive -> four-vector transform and plasma decode (M6); see
+ * athenak_plasma.h.
+ */
+
+#include "athenak_plasma.h"
+
+#include <math.h>
+#include <string.h>
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+void athk_plasma_defaults(athk_plasma_params *par) {
+    memset(par, 0, sizeof *par);
+    par->mu = 0.5;
+    par->ne_ni = 1.0;
+    par->use_p = 1;
+    par->rat_low = 1.0;
+    par->rat_high = 40.0;
+    par->gamma = 13.0 / 9.0;
+    par->gamma_i = 5.0 / 3.0;
+    par->gamma_e = 4.0 / 3.0;
+    par->thermal_frac = 1.0;
+    par->cut_sigma_max = 1.0;
+    par->cut_theta_e_min = -1.0;
+    par->cut_theta_e_max = -1.0;
+}
+
+void athk_plasma_units(athk_plasma_params *par, double m_bh_cgs,
+                       double mass_scale_cgs, double G, double c, double mp,
+                       double me) {
+    par->mp = mp;
+    par->me = me;
+    par->cl = c;
+    par->L_unit = G * m_bh_cgs / (c * c);
+    par->T_unit = par->L_unit / c;
+    par->d_unit = mass_scale_cgs / (par->L_unit * par->L_unit * par->L_unit);
+    par->e_unit = par->d_unit * (c * c);
+    par->b_unit = c * sqrt(4.0 * M_PI * par->d_unit);
+}
+
+/* StaticArrays SMatrix * SVector row: muladd chain from the first column. */
+static void matvec(const double g[4][4], const double v[4], double out[4]) {
+    for (int i = 0; i < 4; i++)
+        out[i] = fma(g[i][3], v[3],
+                     fma(g[i][2], v[2], fma(g[i][1], v[1], g[i][0] * v[0])));
+}
+
+void athk_four_vectors(const double prim[8], const double gcov[4][4],
+                       const double gcon[4][4], athk_fourvec *fv) {
+    const double uu1 = prim[1], uu2 = prim[2], uu3 = prim[3];
+    const double bb1 = prim[5], bb2 = prim[6], bb3 = prim[7];
+    double uu0 = sqrt(1 + gcov[1][1] * uu1 * uu1 + 2 * gcov[1][2] * uu1 * uu2 +
+                      2 * gcov[1][3] * uu1 * uu3 + gcov[2][2] * uu2 * uu2 +
+                      2 * gcov[2][3] * uu2 * uu3 + gcov[3][3] * uu3 * uu3);
+    double lapse = 1 / sqrt(-gcon[0][0]);
+    double shift1 = -gcon[0][1] / gcon[0][0];
+    double shift2 = -gcon[0][2] / gcon[0][0];
+    double shift3 = -gcon[0][3] / gcon[0][0];
+
+    fv->ucon[0] = uu0 / lapse;
+    fv->ucon[1] = uu1 - shift1 * uu0 / lapse;
+    fv->ucon[2] = uu2 - shift2 * uu0 / lapse;
+    fv->ucon[3] = uu3 - shift3 * uu0 / lapse;
+    matvec(gcov, fv->ucon, fv->ucov);
+
+    double b0 = fv->ucov[1] * bb1 + fv->ucov[2] * bb2 + fv->ucov[3] * bb3;
+    fv->bcon[0] = b0;
+    fv->bcon[1] = (bb1 + b0 * fv->ucon[1]) / fv->ucon[0];
+    fv->bcon[2] = (bb2 + b0 * fv->ucon[2]) / fv->ucon[0];
+    fv->bcon[3] = (bb3 + b0 * fv->ucon[3]) / fv->ucon[0];
+    matvec(gcov, fv->bcon, fv->bcov);
+
+    /* LinearAlgebra.dot inlined into primitive_four_vectors compiles to a
+     * fused multiply-add chain (the @simd reduction is contracted) */
+    fv->b_sq = fma(fv->bcon[3], fv->bcov[3],
+                   fma(fv->bcon[2], fv->bcov[2],
+                       fma(fv->bcon[1], fv->bcov[1], fv->bcon[0] * fv->bcov[0])));
+}
+
+static double electron_theta(const athk_plasma_params *c, double rho_cgs,
+                             double pgas_cgs, double beta_inv) {
+    double tti_tte = (c->rat_high + c->rat_low * beta_inv * beta_inv) /
+                     (1.0 + beta_inv * beta_inv);
+    double kb_tt_tot_cgs = c->mu * c->mp * pgas_cgs / rho_cgs;
+    double kb_tt_e_cgs;
+    if (c->use_p != 0) {
+        kb_tt_e_cgs = (1.0 + c->ne_ni) / (tti_tte + c->ne_ni) * kb_tt_tot_cgs;
+    } else {
+        kb_tt_e_cgs = (1.0 + c->ne_ni) * kb_tt_tot_cgs / (c->gamma - 1.0);
+        kb_tt_e_cgs /= tti_tte / (c->gamma_i - 1.0) +
+                       c->ne_ni / (c->gamma_e - 1.0);
+    }
+    double theta_e = kb_tt_e_cgs / (c->me * c->cl * c->cl);
+    return c->thermal_frac == 0.0 ? NAN : theta_e;
+}
+
+int athk_plasma_decode(const athk_plasma_params *c, double rho, double pgas,
+                       double b_sq, athk_plasma *pl) {
+    memset(pl, 0, sizeof *pl);
+    if (rho <= 0.0 || pgas <= 0.0)
+        return 0;
+    if (!(b_sq > 0.0)) /* also NaN: no real u^mu where g^00 >= 0 */
+        return 0;
+    pl->rho_cgs = rho * c->d_unit;
+    pl->pgas_cgs = pgas * c->e_unit;
+    double n_cgs = pl->rho_cgs / (c->mu * c->mp);
+    pl->n_e_cgs = n_cgs / (1.0 + 1.0 / c->ne_ni);
+    pl->bb_cgs = sqrt(b_sq) * c->b_unit;
+    pl->sigma = b_sq / rho;
+    pl->beta_inv = b_sq / (2.0 * pgas);
+    pl->theta_e = electron_theta(c, pl->rho_cgs, pl->pgas_cgs, pl->beta_inv);
+    pl->omit = (c->cut_theta_e_min >= 0.0 && pl->theta_e < c->cut_theta_e_min) ||
+               (c->cut_theta_e_max >= 0.0 && pl->theta_e > c->cut_theta_e_max) ||
+               (c->cut_sigma_max >= 0.0 && pl->sigma > c->cut_sigma_max);
+    return !pl->omit;
+}
diff --git a/model/athenak/athenak_plasma.h b/model/athenak/athenak_plasma.h
new file mode 100644
index 0000000..907c758
--- /dev/null
+++ b/model/athenak/athenak_plasma.h
@@ -0,0 +1,118 @@
+/*
+ * athenak_plasma.h
+ *
+ * Data-layer plasma model for AthenaK GRMHD samples (M6): the primitive ->
+ * four-vector transform and the code-unit -> cgs plasma decode. Both are
+ * line-by-line ports of BlackLightPlus
+ *   src/simulation/primitives.jl   primitive_four_vectors
+ *   src/radiation/coefficients.jl  plasma_decode, electron_theta,
+ *                                  plasma_cut_omits
+ *   src/radiation/integrator.jl    the vacuum gates of eight_coefficients
+ *   src/simulation/athenak_reader.jl units
+ * with the same floating-point operation order (StaticArrays' g * v and the
+ * inlined b.b are fused multiply-add chains), so the results are
+ * bit-identical.
+ *
+ * Interface for the emission side. A sample at position X is turned into
+ * emission inputs in three steps:
+ *
+ *   athk_sample(mesh, X, prim)                         athenak_mesh.h
+ *   athk_four_vectors(prim, gcov, gcon, &fv)           u^mu, b^mu, b^2
+ *   athk_plasma_decode(&par, rho, pgas, fv.b_sq, &pl)  n_e, Theta_e, |B|
+ *
+ * with pgas = athk_pgas(eint, par.gamma). gcov/gcon are the metric and its
+ * inverse at X (RAPTOR metric_dd / metric_uu). The decode returns 1 when the
+ * sample emits; 0 means vacuum (rho <= 0, pgas <= 0, b^2 <= 0 or a plasma cut),
+ * exactly the samples BlackLightPlus skips. The emission coefficients take
+ * pl.n_e_cgs [cm^-3], pl.theta_e and pl.bb_cgs [G]; the pitch angle and the
+ * fluid-frame frequency take fv.ucon/ucov and fv.bcon/bcov (code units:
+ * multiply b by b_unit for Gauss).
+ *
+ * Model (the BlackLightPlus BBH driver, figures/fig_eht_bbh.jl):
+ *   n_e = rho_cgs / (mu m_p) / (1 + 1/(n_e/n_i)) = rho_cgs / m_p for
+ *         mu = 0.5, n_e/n_i = 1;
+ *   Theta_e = (1 + n_e/n_i)/(R + n_e/n_i) mu m_p p/rho / (m_e c^2)
+ *           = (m_p/m_e)(p/rho)/(1 + R) (use_p = 1),
+ *   R = (R_high + R_low beta_inv^2)/(1 + beta_inv^2), beta_inv = b^2/(2p);
+ *   |B| = sqrt(b^2) B_unit; sigma = b^2/rho;
+ *   cut: sigma > sigma_max (sigma_max = 1); a negative bound disables a cut.
+ * No floors, no Theta_e bounds, no radius masks.
+ */
+
+#ifndef ATHENAK_PLASMA_H
+#define ATHENAK_PLASMA_H
+
+typedef struct athk_fourvec {
+    double ucon[4], ucov[4]; /* u^mu, u_mu */
+    double bcon[4], bcov[4]; /* b^mu, b_mu (code units) */
+    double b_sq;             /* b^mu b_mu */
+} athk_fourvec;
+
+typedef struct athk_plasma_params {
+    /* unit conversion (athk_plasma_units) */
+    double L_unit, T_unit, d_unit, e_unit, b_unit;
+    /* physical constants [cgs] */
+    double mp, me, cl;
+    /* plasma model */
+    double mu, ne_ni;
+    int use_p;
+    double rat_low, rat_high;
+    double gamma, gamma_i, gamma_e;
+    double thermal_frac;
+    /* cuts; a negative value disables the cut */
+    double cut_sigma_max, cut_theta_e_min, cut_theta_e_max;
+} athk_plasma_params;
+
+typedef struct athk_plasma {
+    double rho_cgs, pgas_cgs, n_e_cgs, bb_cgs; /* g/cm^3, erg/cm^3, cm^-3, G */
+    double sigma, beta_inv, theta_e;
+    int omit; /* plasma cut fired */
+} athk_plasma;
+
+/*
+ * Defaults of the BlackLightPlus BBH driver: mu = 0.5, n_e/n_i = 1, use_p,
+ * R_low = 1, R_high = 40, gamma = 13/9, gamma_i = 5/3, gamma_e = 4/3,
+ * thermal only, sigma_max = 1, Theta_e bounds off. Constants and units are
+ * left zero; set them with athk_plasma_units.
+ */
+void athk_plasma_defaults(athk_plasma_params *par);
+
+/*
+ * Units for a black-hole (total) mass m_bh_cgs [g] and density mass scale
+ * mass_scale_cgs [g] (BlackLightPlus `units`):
+ *   L = G M / c^2, T = L / c, d_unit = ms / L^3, e_unit = d_unit c^2,
+ *   b_unit = c sqrt(4 pi d_unit).
+ * Stores G-independent constants mp, me, cl too.
+ */
+void athk_plasma_units(athk_plasma_params *par, double m_bh_cgs,
+                       double mass_scale_cgs, double G, double c, double mp,
+                       double me);
+
+/* p_gas = (gamma - 1) eint (BlackLightPlus pgas_from_eint). */
+static inline double athk_pgas(double eint, double gamma) {
+    return (gamma - 1) * eint;
+}
+
+/*
+ * u^mu and b^mu from the AthenaK normal-frame velocity prim[1..3] and lab
+ * field prim[5..7] (athenak_mesh.h primitive order) with the metric gcov and
+ * its inverse gcon at the sample point:
+ *   W = sqrt(1 + gamma_ij u^i u^j), alpha = 1/sqrt(-g^00),
+ *   beta^i = -g^0i/g^00, u^0 = W/alpha, u^i = u^i - beta^i W/alpha,
+ *   b^0 = u_i B^i, b^i = (B^i + b^0 u^i)/u^0.
+ */
+void athk_four_vectors(const double prim[8], const double gcov[4][4],
+                       const double gcon[4][4], athk_fourvec *fv);
+
+/*
+ * Code-unit -> cgs decode of one sample and the emission gate. Returns 1 when
+ * the sample emits, 0 for vacuum (rho <= 0, pgas <= 0, b_sq <= 0) or a cut
+ * (pl->omit). pl is filled whenever rho > 0, pgas > 0 and b_sq > 0. A NaN
+ * b_sq (the four-vectors do not exist: g^00 >= 0, which the superposed metric
+ * reaches only deep inside a horizon, near a ring singularity) is vacuum;
+ * BlackLightPlus never samples there (its march stops at the horizon).
+ */
+int athk_plasma_decode(const athk_plasma_params *par, double rho, double pgas,
+                       double b_sq, athk_plasma *pl);
+
+#endif /* ATHENAK_PLASMA_H */
diff --git a/model/athenak/model.c b/model/athenak/model.c
new file mode 100644
index 0000000..debb967
--- /dev/null
+++ b/model/athenak/model.c
@@ -0,0 +1,128 @@
+/*
+ * model.c — AthenaK GRMHD model for RAPTOR (M5 reader, M6 plasma model)
+ *
+ * Reads an AthenaK `.bin` or `.athdf` snapshot of the `mhd_w_bcc` group
+ * (athenak_mesh.c) and returns per sample the fluid state of the
+ * BlackLightPlus BBH driver (athenak_plasma.c):
+ *   - primitives by clamped trilinear interpolation on cell centres inside the
+ *     owning meshblock (BlackLightPlus ownership and sampling, bit-identical);
+ *   - u^mu, b^mu from the normal-frame velocity and lab field with the
+ *     compiled metric (metric_dd, metric_uu) at the sample point;
+ *   - n_e = rho/m_p, |B| = sqrt(b^2) B_unit,
+ *     Theta_e = (m_p/m_e)(p/rho)/(1 + R(beta)) with p = (gamma - 1) eint and
+ *     the dump's gamma;
+ *   - vacuum where rho <= 0, p <= 0 or b^2 <= 0; emission cut sigma > 1 only.
+ * There are no density or field floors, no Theta_e bounds and no radius
+ * masks. The sample coordinates are Cartesian Kerr-Schild (x, y, z).
+ */
+
+#include "definitions.h"
+#include "functions.h"
+#include "global_vars.h"
+#include "model_definitions.h"
+#include "model_functions.h"
+#include "model_global_vars.h"
+
+#if !(metric == CKS || (defined(SKS) && metric == SKS))
+#error "model athenak samples Cartesian Kerr-Schild positions: use metric CKS or SKS"
+#endif
+
+// GLOBAL VARS
+//////////////
+
+double ****p = NULL;
+
+double L_unit, T_unit;
+double RHO_unit, U_unit, B_unit;
+double Ne_unit, Thetae_unit;
+
+double R0, a, Q, hslope;
+
+athk_mesh athk;
+athk_plasma_params athk_par;
+
+// FUNCTIONS
+////////////
+
+void init_model() {
+    athk_plasma_defaults(&athk_par);
+    athk_par.rat_high = R_HIGH;
+    athk_par.rat_low = R_LOW;
+    athk_par.cut_sigma_max = ATHK_SIGMA_CUT;
+
+    set_units(M_UNIT);
+
+    fprintf(stderr, "\nReading AthenaK snapshot %s...\n", GRMHD_FILE);
+    if (athk_load(GRMHD_FILE, ATHK_GAMMA_OVERRIDE, ATHK_LOAD_THREADS, &athk)) {
+        fprintf(stderr, "AthenaK read failed. Aborting.\n");
+        exit(1);
+    }
+    athk_par.gamma = athk.gamma;
+    a = athk.spin_a; /* single-hole metrics; the binary metric has its own spins */
+    const char *mode[3] = {"table", "hash", "scan"};
+    fprintf(stderr,
+            "AthenaK %s: %d blocks of %dx%dx%d, t = %g, gamma = %.12g, "
+            "locate %s, %.2f GB in %.2f s, %zu non-finite values zeroed\n",
+            athk.format, athk.nmb, athk.ni, athk.nj, athk.nk, athk.time,
+            athk.gamma, mode[athk.locate_mode], athk.bytes_data / 1073741824.,
+            athk.load_seconds, athk.nbad);
+}
+
+void set_units(double M_unit_) {
+    athk_plasma_units(&athk_par, MBH, M_unit_, GGRAV, SPEED_OF_LIGHT,
+                      PROTON_MASS, ELECTRON_MASS);
+    L_unit = athk_par.L_unit;
+    T_unit = athk_par.T_unit;
+    RHO_unit = athk_par.d_unit;
+    U_unit = athk_par.e_unit;
+    B_unit = athk_par.b_unit;
+    Ne_unit = RHO_unit / (athk_par.mu * PROTON_MASS) /
+              (1.0 + 1.0 / athk_par.ne_ni);
+}
+
+// Fluid state at X (t, x, y, z). Returns 1 when the sample emits.
+int get_fluid_params(double X[NDIM], struct GRMHD *modvar) {
+    modvar->n_e = 0.;
+    modvar->B = 0.;
+    modvar->theta_e = 0.;
+    modvar->sigma = 0.;
+    modvar->beta = 0.;
+    modvar->sigma_min = athk_par.cut_sigma_max;
+
+    double prim[ATHK_NPRIM];
+    int b = athk_sample(&athk, X[1], X[2], X[3], prim);
+    modvar->igrid_c = b;
+    if (b < 0)
+        return 0;
+    modvar->dx_local = athk.dx[3 * b];
+
+    double g_dd[NDIM][NDIM], g_uu[NDIM][NDIM];
+    metric_dd(X, g_dd);
+    metric_uu(X, g_uu);
+    athk_fourvec fv;
+    athk_four_vectors(prim, g_dd, g_uu, &fv);
+    for (int i = 0; i < NDIM; i++) {
+        modvar->U_u[i] = fv.ucon[i];
+        modvar->U_d[i] = fv.ucov[i];
+        modvar->B_u[i] = fv.bcon[i];
+        modvar->B_d[i] = fv.bcov[i];
+    }
+
+    athk_plasma pl;
+    double pgas = athk_pgas(prim[ATHK_EINT], athk.gamma);
+    int emit = athk_plasma_decode(&athk_par, prim[ATHK_DENS], pgas, fv.b_sq, &pl);
+    modvar->B = pl.bb_cgs;
+    modvar->theta_e = pl.theta_e;
+    modvar->sigma = pl.sigma;
+    modvar->beta = pl.beta_inv > 0. ? 1. / pl.beta_inv : 0.;
+    if (!emit)
+        return 0;
+    modvar->n_e = pl.n_e_cgs;
+    return 1;
+}
+
+void compute_spec_user(struct Camera *intensityfield,
+                       double energy_spectrum[num_frequencies][nspec]) {
+    (void)intensityfield;
+    (void)energy_spectrum;
+}
