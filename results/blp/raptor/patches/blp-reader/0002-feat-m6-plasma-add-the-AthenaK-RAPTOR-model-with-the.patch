+/*
+ * model_definitions.h — AthenaK GRMHD model (M5, M6)
+ *
+ * The fluid state RAPTOR's transfer reads per sample (struct GRMHD) and the
+ * compile-time switches of the AthenaK model.
+ */
+
+#ifndef MODEL_DEFINITIONS_H
+#define MODEL_DEFINITIONS_H
+
+#define SFC 0
+
+#define PLUS 1
+#define MINUS -1
+#define BPOL (PLUS)
+
+/* adiabatic index for press -> eint; <= 0 uses the dump's <mhd>/gamma */
+#define ATHK_GAMMA_OVERRIDE (0.)
+/* emission cut sigma = b^2/rho > ATHK_SIGMA_CUT (negative disables) */
+#define ATHK_SIGMA_CUT (1.0)
+/* reader threads; <= 0 uses min(OMP_NUM_THREADS, 16) */
+#define ATHK_LOAD_THREADS (0)
+
+typedef struct GRMHD {
+    double U_u[4];
+    double B_u[4];
+    double U_d[4];
+    double B_d[4];
+    double n_e;
+    double B;
+    double theta_e;
+    double sigma;
+    double sigma_min;
+    double dx_local;
+    double beta;
+    int igrid_c;
+} GRMHD;
+
+#endif
