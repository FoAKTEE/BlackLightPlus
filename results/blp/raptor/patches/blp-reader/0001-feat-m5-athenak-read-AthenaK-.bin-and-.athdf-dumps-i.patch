+/*
+ * athenak_mesh.h
+ *
+ * AthenaK GRMHD snapshot reader and meshblock sampler (M5).
+ *
+ * Reads AthenaK "Athena binary output version=1.1" `.bin` dumps and `.athdf`
+ * (HDF5) dumps of the `mhd_w_bcc` output group into one contiguous Float32
+ * array laid out [block][prim][k][j][i], with the eight primitives
+ *
+ *     dens, velx, vely, velz, eint, bcc1, bcc2, bcc3
+ *
+ * (normal-frame velocity u^i = W v^i, cell-centred lab field B^i). A stored
+ * pressure is converted once to eint = Float32(press / (gamma - 1)) in double,
+ * with gamma the dump's <mhd>/gamma unless overridden; the temperature column
+ * is dropped; non-finite cells are zeroed.
+ *
+ * Block location and sampling reproduce BlackLightPlus `meshblock_index` and
+ * `sample_primitives` (src/simulation/athenak_reader.jl) operation for
+ * operation, so the owning block and the interpolated primitives are
+ * bit-identical:
+ *   - locate: a dense finest-block index grid when it has at most
+ *     ATHK_LEAF_MAX_CELLS cells, else a hash keyed by (level, lx1, lx2, lx3)
+ *     probed coarse to fine, else a linear scan. The grid and the hash own a
+ *     point by lo <= x < hi (floor of the scaled offset); the scan by
+ *     lo < x <= hi with the last (finest) block winning. The three agree off
+ *     block faces.
+ *   - sample: trilinear on cell centres inside the owning block, the low
+ *     corner clamped to [0, n-2] and the weights to [0, 1] (one-sided at the
+ *     block's outer half cell, no ghost zones).
+ *
+ * The code has no dependence on RAPTOR globals and is used both by the
+ * RAPTOR model plug-in (model.c) and by the stand-alone probe
+ * (tests/athenak_probe.c).
+ */
+
+#ifndef ATHENAK_MESH_H
+#define ATHENAK_MESH_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define ATHK_NPRIM 8
+#define ATHK_DENS 0
+#define ATHK_VELX 1
+#define ATHK_VELY 2
+#define ATHK_VELZ 3
+#define ATHK_EINT 4
+#define ATHK_BCC1 5
+#define ATHK_BCC2 6
+#define ATHK_BCC3 7
+
+/* Dense leaf-table cap, BlackLightPlus `_LEAF_MAX_CELLS`. */
+#define ATHK_LEAF_MAX_CELLS 8000000L
+
+enum athk_locate_mode { ATHK_LOCATE_TABLE = 0, ATHK_LOCATE_HASH = 1,
+                        ATHK_LOCATE_SCAN = 2 };
+
+typedef struct athk_mesh {
+    /* geometry */
+    int nmb;            /* number of meshblocks */
+    int ni, nj, nk;     /* cells per block along x1, x2, x3 */
+    size_t cells;       /* ni * nj * nk */
+    float *data;        /* [nmb][ATHK_NPRIM][nk][nj][ni] */
+    double *ext_lo;     /* [nmb][3] low block face */
+    double *ext_hi;     /* [nmb][3] high block face */
+    double *x_left;     /* [nmb][3] first cell centre */
+    double *dx;         /* [nmb][3] cell spacing */
+    int *level;         /* [nmb] refinement level */
+    long *lloc;         /* [nmb][3] logical location at its level */
+
+    /* dump metadata */
+    double time;        /* dump time */
+    double gamma;       /* adiabatic index used for eint (dump or override) */
+    double gamma_dump;  /* <mhd>/gamma from the dump (NaN if absent) */
+    double spin_a;      /* <coord>/a from the dump (0 if absent) */
+    int stored_press;   /* 1: the dump stores press (converted to eint) */
+    size_t nbad;        /* zeroed non-finite values */
+    char format[8];     /* "bin" or "athdf" */
+
+    /* locate structures */
+    int locate_mode;
+    /* dense table */
+    int32_t *leaf;      /* [N3][N2][N1], 1-based block, 0 = vacuum */
+    long N[3];
+    double tmin[3], tmax[3], inv_fdx[3];
+    /* level hash */
+    uint64_t *hkey;     /* open addressing, 0 = empty slot */
+    int32_t *hval;      /* 1-based block */
+    size_t hcap;        /* power of two */
+    int nlev;
+    int lev[64];        /* levels present, ascending */
+    double hmin[3], hmax[3], inv_w0[3];
+
+    /* load statistics */
+    double load_seconds;
+    size_t bytes_data;  /* size of `data` */
+} athk_mesh;
+
+/*
+ * Load `path` (".bin" or anything else as ".athdf"). gamma_override > 0
+ * replaces the dump's <mhd>/gamma for the press -> eint conversion.
+ * nthreads <= 0 uses min(omp_get_max_threads(), 16) readers. Returns 0 on
+ * success; on failure prints the reason to stderr and returns nonzero.
+ */
+int athk_load(const char *path, double gamma_override, int nthreads,
+              athk_mesh *m);
+
+void athk_free(athk_mesh *m);
+
