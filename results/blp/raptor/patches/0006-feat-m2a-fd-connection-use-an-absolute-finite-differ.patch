From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FoAKTEE <hw609@cantab.ac.uk>
Date: Fri, 25 Sep 2026 11:48:06 -0700
Subject: [PATCH 06/24] feat(m2a-fd-connection): use an absolute
 finite-difference step for SKS

- change: connection_num_udd for SKS differentiates with h = delta_num max(1, min_A r_A) (4th-order central stencil unchanged) instead of the CKS step h ~ |x^i|, which collapses to 1e-10 at x^i ~ 0
- change: the t column is skipped for SKS (static metric, d_t g = 0 exactly)
- next: M2b analytic connection as the reference; R04 comparison against the BlackLightPlus AD Christoffels
---
 src/metric.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/src/metric.c b/src/metric.c
index 30e15ab..aa7f3cd 100755
--- a/src/metric.c
+++ b/src/metric.c
@@ -461,7 +461,19 @@ void connection_num_udd(double X_u[4], double gamma_udd[4][4][4]) {
 
     LOOP_ijk delta[i][j] += g_uu[i][k] * g_dd[k][j];
 
-    for (int i = 0; i < 4; i++) {
+#if (metric == SKS)
+    // Static metric: d_t g = 0 exactly, so the t column is skipped. Absolute
+    // step h = delta_num * max(1, min_A r_A): the same relative resolution of
+    // the nearest hole's scale everywhere, instead of h ~ |x^i| (which drops
+    // to 1e-10 at x^i ~ 0).
+    double sks_rmin = INFINITY;
+    for (int A = 0; A < bbh.n; A++)
+        sks_rmin = fmin(sks_rmin, ks_radius_hole(X_u, A));
+    const int i_start = 1;
+#else
+    const int i_start = 0;
+#endif
+    for (int i = i_start; i < 4; i++) {
         for (int j = 0; j < 4; j++) {
             X_u_temp[j] = X_u[j];
         }
@@ -473,6 +485,8 @@ void connection_num_udd(double X_u[4], double gamma_udd[4][4][4]) {
             fac = fabs(X_u[i]);
         else
             fac = delta_num * 1e-2;
+#elif (metric == SKS)
+        double fac = fmax(1.0, sks_rmin);
 #else
         double fac = 1.0;
 #endif
